<UserControl x:Class="WoWBoxer.Layouts.App.Views.GuideView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:WoWBoxer.Layouts.App"
             xmlns:vm="using:WoWBoxer.Layouts.App.ViewModels"
             x:DataType="vm:MainViewModel">
    <!-- Quest log: chapter list on the left, a parchment page on the right (app mockup v0.2, 3-Guide) -->
    <UserControl.Resources>
        <ControlTheme x:Key="ChapterButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="6" Padding="10,10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#1AC9A24A" />
                <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
            </Style>
            <Style Selector="^.current">
                <Setter Property="Background" Value="#29C9A24A" />
                <Setter Property="BorderBrush" Value="{StaticResource UiGoldBrush}" />
                <Setter Property="BorderThickness" Value="2,0,0,0" />
                <Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="ParchmentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="B" CornerRadius="6" BorderThickness="1" BorderBrush="#5A3A12" Padding="20,12">
                        <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#6E4A1A" Offset="0" /><GradientStop Color="#4A2E0E" Offset="1" /></LinearGradientBrush></Border.Background>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="#F3EAD2" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#B"><Setter Property="Opacity" Value="0.88" /></Style>
        </ControlTheme>
    </UserControl.Resources>

    <Grid DataContext="{Binding Guide}" x:DataType="vm:GuideViewModel" MaxWidth="1240" ColumnDefinitions="300,*">
        <Border CornerRadius="10,0,0,10" BorderThickness="1,1,0,1" BorderBrush="#73C9A24A" Padding="12,18">
            <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#1C2333" Offset="0" /><GradientStop Color="#121722" Offset="1" /></LinearGradientBrush></Border.Background>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="QUICK GUIDE" Theme="{StaticResource H2}" Foreground="{StaticResource GoldHiBrush}" Margin="8,0,0,12" />
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Theme="{StaticResource EnterWorldButton}" FontSize="13.5" Padding="12,10" HorizontalAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenUrlCommand}"
                            CommandParameter="{x:Static vm:MainViewModel.WebsiteGuideUrl}" ToolTip.Tip="Opens the full guide in your browser">
                        <TextBlock Text="FULL GUIDE ON THE WEBSITE  ↗" />
                    </Button>
                    <TextBlock Text="Pictures, videos and the rules – on the WoWBoxer website" Theme="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Chapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuideChapter">
                            <Button Theme="{StaticResource ChapterButton}" Classes.current="{Binding IsCurrent}" HorizontalAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:GuideViewModel)DataContext).PickCommand}" CommandParameter="{Binding}" Margin="0,0,0,4" AutomationProperties.Name="{Binding Title}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Mark}" FontFamily="{StaticResource DisplayFont}" FontSize="16" Width="20" Classes.current="{Binding IsCurrent}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock"><Setter Property="Foreground" Value="{StaticResource GoldLoBrush}" /></Style>
                                            <Style Selector="TextBlock.current"><Setter Property="Foreground" Value="{StaticResource UiGoldBrush}" /></Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Width="230" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- the parchment page -->
        <Border Grid.Column="1" CornerRadius="0,10,10,0" BorderThickness="1" BorderBrush="#8C6B26" ClipToBounds="True">
            <Border.Background>
                <RadialGradientBrush Center="30%,20%" GradientOrigin="30%,20%" RadiusX="90%" RadiusY="110%">
                    <GradientStop Color="#F3EAD2" Offset="0" /><GradientStop Color="#E9DFC4" Offset="0.55" /><GradientStop Color="#D9C9A0" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Panel>
                <!-- burnt edge: a soft brown vignette -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush RadiusX="72%" RadiusY="78%" Center="50%,45%" GradientOrigin="50%,45%">
                            <GradientStop Color="#00785014" Offset="0.62" /><GradientStop Color="#55785014" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Page" Margin="48,40,48,40" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ChapterText}" FontSize="12" Foreground="#7A5A22" />
                        <StackPanel DataContext="{Binding Current}" x:DataType="vm:GuideChapter">
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="32" Foreground="#3A2410" Margin="0,6,0,16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Intro}" FontSize="16" LineHeight="26" Foreground="#3B2A14" TextWrapping="Wrap" Margin="0,0,0,20" />
                            <TextBlock Text="Objectives" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="#5A3A12" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Objectives}" Margin="0,0,0,22">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <DockPanel Margin="0,0,0,10">
                                            <Rectangle Width="8" Height="8" Fill="#8C6B26" VerticalAlignment="Top" Margin="2,8,12,0" RenderTransform="rotate(45deg)" />
                                            <TextBlock Text="{Binding}" FontSize="15" LineHeight="24" Foreground="#2B1E0E" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border CornerRadius="6" Background="#1A5A3A12" BorderBrush="#595A3A12" BorderThickness="1" Padding="16,14">
                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#3B2A14">
                                    <Run Text="Good to know – " FontFamily="{StaticResource DisplayFont}" Foreground="#5A3A12" /><Run Text="{Binding Note, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Button Theme="{StaticResource ParchmentButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding ActionCommand}" Content="{Binding Action}"
                                    IsVisible="{Binding HasAction, Converter={x:Static app:BoolVisibility.Instance}}" />
                            <!-- Switch between windows: the hover-to-activate switch itself, one click -->
                            <Border Margin="0,18,0,0" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1" BorderBrush="#5A3A12" Padding="20,12"
                                    IsVisible="{Binding HasHover, Converter={x:Static app:BoolVisibility.Instance}}">
                                <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#6E4A1A" Offset="0" /><GradientStop Color="#4A2E0E" Offset="1" /></LinearGradientBrush></Border.Background>
                                <StackPanel DataContext="{Binding Hover}" x:DataType="vm:HoverViewModel">
                                    <CheckBox Theme="{StaticResource Switch}" IsChecked="{Binding Enabled}" Foreground="#F3EAD2" AutomationProperties.Name="Hover to activate windows">
                                        <TextBlock Text="Hover to activate windows" FontFamily="{StaticResource DisplayFont}" FontSize="14" />
                                    </CheckBox>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#E0D2AE" Text="{Binding DelayText, StringFormat='Delay {0}. Delay and bring-to-front: Settings › Switching windows.'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>

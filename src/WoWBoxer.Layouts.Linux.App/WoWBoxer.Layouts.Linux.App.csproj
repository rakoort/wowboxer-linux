<Project Sdk="Microsoft.NET.Sdk">

  <!-- WoWBoxer for Linux: the WPF app (src/WoWBoxer.Layouts.App) ported to Avalonia, over WoWBoxer.Layouts.Linux. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WoWBoxer.Layouts.App</RootNamespace>
    <AssemblyName>wowboxer</AssemblyName>
    <AssemblyTitle>WoWBoxer</AssemblyTitle>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- The body font, bundled: Linux desktops and the screenshot run look the same. -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
  </ItemGroup>

  <!-- "WoWBoxer Dev" (dotnet build -p:WbxDev=true): own settings folder, single-instance name and DEV badge (AppFlavor.cs). -->
  <PropertyGroup Condition="'$(WbxDev)' == 'true'">
    <DefineConstants>$(DefineConstants);WBX_DEV</DefineConstants>
    <AssemblyTitle>WoWBoxer Dev</AssemblyTitle>
  </PropertyGroup>

  <!-- The upstream app's fonts and icons, used in place (one copy in the repo). -->
  <ItemGroup>
    <AvaloniaResource Include="..\WoWBoxer.Layouts.App\Assets\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\WoWBoxer.Layouts.App\Assets\splash.png" Link="Assets\splash.png" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(WbxDev)' != 'true'">
    <AvaloniaResource Include="..\WoWBoxer.Layouts.App\Assets\app.png" Link="Assets\app.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(WbxDev)' == 'true'">
    <AvaloniaResource Include="..\WoWBoxer.Layouts.App\Assets\dev\app.png" Link="Assets\app.png" />
  </ItemGroup>

  <!-- The KWin script ships next to the app: <app dir>/kwin/wowboxer-agent/… (the backend loads it into KWin). -->
  <ItemGroup>
    <None Include="..\..\kwin\wowboxer-agent\**" Link="kwin\wowboxer-agent\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WoWBoxer.Layouts.Core\WoWBoxer.Layouts.Core.csproj" />
    <ProjectReference Include="..\WoWBoxer.Layouts.Linux\WoWBoxer.Layouts.Linux.csproj" />
  </ItemGroup>

</Project>
